{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.conduz-cobre.invalid/v1/oauth-start.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "const": "synthetic"
    },
    "operation": {
      "const": "conduz_cobre"
    },
    "account_ref": {
      "const": "conduz-cobre-b0"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorization_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://oauth\\.synthetic\\.invalid/authorize\\?"
        },
        "synthetic_callback_path": {
          "type": "string",
          "pattern": "^/internal/oauth/callback\\?"
        },
        "expires_in": {
          "const": 300
        },
        "pkce_method": {
          "const": "S256"
        }
      },
      "required": [
        "authorization_url",
        "synthetic_callback_path",
        "expires_in",
        "pkce_method"
      ]
    }
  },
  "required": [
    "schema_version",
    "source",
    "operation",
    "account_ref",
    "fetched_at",
    "request_id",
    "data"
  ]
}
