{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.conduz-cobre.invalid/v1/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "const": "synthetic"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    }
  },
  "required": [
    "schema_version",
    "source",
    "request_id",
    "error"
  ]
}
