{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conduz-cobre-b0-synthetic",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TRANSPORT": "synthetic",
    "APP_ENV": "b0-local",
    "EXPECTED_SELLER_ID": "SELLER_CONDUZ_SYNTHETIC",
    "OAUTH_REDIRECT_URI": "http://localhost:8787/internal/oauth/callback"
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_VAULT", "class_name": "AccountVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountVault"] }],
  "observability": { "enabled": false }
}
