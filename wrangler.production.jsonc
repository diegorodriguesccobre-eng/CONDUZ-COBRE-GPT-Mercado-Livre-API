{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conduz-cobre-ml-api",
  "main": "src/preparation/entrypoint.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PREPARATION_CONFIG": {
      "stage": "production-preparation",
      "transport": "disabled",
      "tenant": "conduz_cobre",
      "publicOrigin": "https://conduz-cobre-ml-api.conduz-cobre.workers.dev",
      "redirectUri": "https://conduz-cobre-ml-api.conduz-cobre.workers.dev/oauth/mercadolivre/callback",
      "accessIssuer": "",
      "accessAudience": "",
      "operatorRoles": {},
      "accountRef": "conduz-cobre-production",
      "expectedSellerId": ""
    }
  },
  "durable_objects": {
    "bindings": [{ "name": "BROWSER_OAUTH_VAULT", "class_name": "BrowserOAuthVault" }]
  },
  "migrations": [{ "tag": "b1-browser-v1", "new_sqlite_classes": ["BrowserOAuthVault"] }],
  "observability": { "enabled": false }
}
